board = [' '] * 9

def display():
    for i in range(0, 9, 3):
        print(board[i], '|', board[i+1], '|', board[i+2])

def winner(mark):
    lines = [
        (0,1,2), (3,4,5), (6,7,8),
        (0,3,6), (1,4,7), (2,5,8),
        (0,4,8), (2,4,6)
    ]

    return any(all(board[i] == mark for i in line)
               for line in lines)

while True:
    display()

    pos = int(input("Player X position (1-9): ")) - 1

    if pos not in range(9) or board[pos] != ' ':
        print("Invalid position")
        continue

    board[pos] = 'X'

    if winner('X'):
        display()
        print("Player X Wins")
        break

    if ' ' not in board:
        print("Draw")
        break

    display()

    pos = int(input("Player O position (1-9): ")) - 1

    if pos not in range(9) or board[pos] != ' ':
        print("Invalid position")
        continue

    board[pos] = 'O'

    if winner('O'):
        display()
        print("Player O Wins")
        break

    if ' ' not in board:
        print("Draw")
        break
