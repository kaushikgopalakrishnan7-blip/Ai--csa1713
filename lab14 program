tree = {
    'A': ['B', 'C'],
    'B': ['D', 'E'],
    'C': ['F', 'G']
}

values = {
    'D': 3,
    'E': 5,
    'F': 2,
    'G': 9
}

def alphabeta(node, alpha, beta, maximizing):

    if node not in tree:
        return values[node]

    if maximizing:
        best = float('-inf')

        for child in tree[node]:
            best = max(best, alphabeta(
                child, alpha, beta, False))

            alpha = max(alpha, best)

            if beta <= alpha:
                break

        return best

    else:
        best = float('inf')

        for child in tree[node]:
            best = min(best, alphabeta(
                child, alpha, beta, True))

            beta = min(beta, best)

            if beta <= alpha:
                break

        return best

print("Best Value:", alphabeta(
    'A', float('-inf'), float('inf'), True))
