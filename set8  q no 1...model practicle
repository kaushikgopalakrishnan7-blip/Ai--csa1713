def astar(start, goal, obstacles):
    open_list = [(0, start)]
    cost = {start: 0}
    parent = {}

    while open_list:
        open_list.sort()
        _, current = open_list.pop(0)

        if current == goal:
            path = []
            while current in parent:
                path.append(current)
                current = parent[current]
            path.append(start)
            return path[::-1]

        x, y = current

        for dx, dy in [(0,1), (1,0), (0,-1), (-1,0)]:
            next_pos = (x+dx, y+dy)

            if (0 <= next_pos[0] < 5 and
                0 <= next_pos[1] < 5 and
                next_pos not in obstacles):

                new_cost = cost[current] + 1

                if next_pos not in cost or new_cost < cost[next_pos]:
                    cost[next_pos] = new_cost
                    h = abs(goal[0]-next_pos[0]) + abs(goal[1]-next_pos[1])
                    f = new_cost + h
                    parent[next_pos] = current
                    open_list.append((f, next_pos))

    return None


start = (0, 0)
goal = (4, 4)
obstacles = [(1,1), (2,2), (3,3)]

path = astar(start, goal, obstacles)
print("Shortest Path:", path)
