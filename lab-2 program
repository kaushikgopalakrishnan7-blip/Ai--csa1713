def is_safe(board, row, col):
    """
    Checks if a queen can be placed safely at board[row][col].
    Only need to check left side since we place queens column by column.
    """
    # Check the current row on the left side
    for i in range(col):
        if board[row][i] == 1:
            return False

    # Check upper-left diagonal
    for i, j in zip(range(row, -1, -1), range(col, -1, -1)):
        if board[i][j] == 1:
            return False

    # Check lower-left diagonal
    for i, j in zip(range(row, 8, 1), range(col, -1, -1)):
        if board[i][j] == 1:
            return False

    return True


def solve_nqueens_util(board, col, solutions):
    """
    Utility function using backtracking to place queens column by column.
    """
    # Base Case: All 8 queens are placed
    if col >= 8:
        # Store a deep copy of the successful board state
        solution = [row[:] for row in board]
        solutions.append(solution)
        return

    # Try placing a queen in all rows of the current column
    for row in range(8):
        if is_safe(board, row, col):
            # Place queen
            board[row][col] = 1

            # Recur to place the rest of the queens
            solve_nqueens_util(board, col + 1, solutions)

            # Backtrack: Remove queen if it doesn't lead to a solution
            board[row][col] = 0


def solve_8_queens():
    """Finds all unique solutions for the 8-Queens problem."""
    # Initialize 8x8 chessboard with zeros
    board = [[0] * 8 for _ in range(8)]
    solutions = []

    solve_nqueens_util(board, 0, solutions)
    return solutions


def print_board(board):
    """Formats and prints the chessboard with 'Q' for Queens and '.' for empty spaces."""
    print("+" + "---+" * 8)
    for row in board:
        line = "| " + " | ".join("Q" if cell == 1 else "." for cell in row) + " |"
        print(line)
        print("+" + "---+" * 8)


# Example Usage:
if __name__ == "__main__":
    all_solutions = solve_8_queens()

    print(f"Total Solutions Found: {len(all_solutions)}\n")
    print("Displaying Solution #1:\n")
    print_board(all_solutions[0])
