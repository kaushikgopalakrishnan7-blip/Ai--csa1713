import heapq

# Goal state representation (0 represents the empty tile)
GOAL_STATE = (1, 2, 3, 
              4, 5, 6, 
              7, 8, 0)

class PuzzleNode:
    def __init__(self, state, parent=None, move="", g_cost=0):
        self.state = state          # Tuple of 9 integers representing grid
        self.parent = parent        # Parent node to trace back path
        self.move = move            # Action taken to reach this state
        self.g_cost = g_cost        # Path cost from start to current node
        self.h_cost = self.calculate_manhattan() # Heuristic cost
        self.f_cost = self.g_cost + self.h_cost  # Total estimated cost

    def calculate_manhattan(self):
        """Calculates Manhattan distance heuristic for the current state."""
        distance = 0
        for index, tile in enumerate(self.state):
            if tile != 0:
                # Target row and column for the current tile value
                target_row = (tile - 1) // 3
                target_col = (tile - 1) % 3
                # Current row and column of the tile
                current_row = index // 3
                current_col = index % 3
                distance += abs(target_row - current_row) + abs(target_col - current_col)
        return distance

    def get_neighbors(self):
        """Generates valid next states by moving the empty tile (0)."""
        neighbors = []
        zero_idx = self.state.index(0)
        row, col = zero_idx // 3, zero_idx % 3

        # Possible moves: Up, Down, Left, Right
        moves = {
            "Up": (row - 1, col),
            "Down": (row + 1, col),
            "Left": (row, col - 1),
            "Right": (row, col + 1)
        }

        for move_name, (r, c) in moves.items():
            if 0 <= r < 3 and 0 <= c < 3:
                new_zero_idx = r * 3 + c
                new_state = list(self.state)
                # Swap 0 with the target tile
                new_state[zero_idx], new_state[new_zero_idx] = new_state[new_zero_idx], new_state[zero_idx]
                neighbors.append(PuzzleNode(tuple(new_state), self, move_name, self.g_cost + 1))

        return neighbors

    def __lt__(self, other):
        # Priority queue comparison based on f_cost
        return self.f_cost < other.f_cost


def is_solvable(state):
    """Checks if a given initial state is solvable by counting inversions."""
    inversions = 0
    flat_state = [tile for tile in state if tile != 0]
    for i in range(len(flat_state)):
        for j in range(i + 1, len(flat_state)):
            if flat_state[i] > flat_state[j]:
                inversions += 1
    # For a 3x3 puzzle, it is solvable if the number of inversions is even
    return inversions % 2 == 0


def solve_8_puzzle(initial_state):
    """Solves the 8-puzzle problem using A* algorithm."""
    if not is_solvable(initial_state):
        return None, "Unsolvable configuration."

    start_node = PuzzleNode(initial_state)
    open_set = []
    heapq.heappush(open_set, start_node)
    
    # Keeps track of visited states to prevent loops
    visited = set()

    while open_set:
        current_node = heapq.heappop(open_set)

        if current_node.state == GOAL_STATE:
            # Reconstruct path from start to goal
            path = []
            curr = current_node
            while curr:
                path.append(curr)
                curr = curr.parent
            return path[::-1], f"Solved in {current_node.g_cost} moves."

        visited.add(current_node.state)

        for neighbor in current_node.get_neighbors():
            if neighbor.state not in visited:
                heapq.heappush(open_set, neighbor)

    return None, "No solution found."


def print_board(state):
    """Prints state formatted as a 3x3 grid."""
    for i in range(0, 9, 3):
        print(f" {state[i] if state[i] != 0 else ' '} | {state[i+1] if state[i+1] != 0 else ' '} | {state[i+2] if state[i+2] != 0 else ' '}")
        if i < 6:
            print("---+---+---")


# Example Usage:
if __name__ == "__main__":
    # Initial state (0 represents empty space)
    initial_state = (1, 2, 3,
                     4, 0, 6,
                     7, 5, 8)

    print("Initial State:")
    print_board(initial_state)
    print("\nSolving...\n")

    path, message = solve_8_puzzle(initial_state)

    if path:
        print(message)
        print("=" * 30)
        for step, node in enumerate(path):
            if step > 0:
                print(f"Step {step}: Move {node.move}")
                print_board(node.state)
                print("-" * 15)
    else:
        print(message)
